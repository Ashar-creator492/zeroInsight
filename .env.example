DATABASE_URL=postgresql+psycopg://zeroinsight:change-me@localhost:5432/zeroinsight
# Phase 2 review classification. Set the key only in your private .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated allowed browser origins; specify only trusted frontend origins.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Private single-user admin token; generate a random value and set it only in backend .env.
ADMIN_TOKEN=
