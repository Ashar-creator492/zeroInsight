# Copy to .env.docker; use a strong random alphanumeric password for both entries.
# The URL password must be URL-encoded if it contains special characters.
POSTGRES_PASSWORD=replace-with-private-password
DOCKER_DATABASE_URL=postgresql+psycopg://zeroinsight:replace-with-private-password@db:5432/zeroinsight
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ADMIN_TOKEN=
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
